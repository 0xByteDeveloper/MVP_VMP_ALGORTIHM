+// 3.9.4 upgrade: random section names (VMProtect 3.6+ "mask" feature)
+std::string NextSectionName(const CompileOptions &options, uint32_t index, size_t max_len)
+{
+	std::string mask = options.section_name;
+	if (mask.find('?') == std::string::npos) {
+		// 3.5.1 behaviour: fixed name + running index
+		std::string res = string_format("%s%d", mask.c_str(), index);
+		if (max_len && res.size() > max_len)
+			res.resize(max_len);
+		return res;
+	}
+	static const char symbols[] = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!#$%&'()*+,-.@^_`{}~";
+	std::string res;
+	for (size_t i = 0; i < mask.size(); i++) {
+		if (max_len && res.size() >= max_len)
+			break;
+		res += (mask[i] == '?') ? symbols[rand() % (sizeof(symbols) - 1)] : mask[i];
+	}
+	return res;
+}
